# Copiar a .env y completar con las credenciales del proyecto Supabase.
# .env está en .gitignore: nunca se commitea con valores reales.
#
# Sin prefijo NEXT_PUBLIC_ a propósito: estas credenciales solo se usan
# server-side (ver src/lib/supabase/server.ts y
# vault/01-Decisiones/2026-08-28-seguridad-sin-auth.md). El cliente
# (navegador) nunca debe tener acceso a la service role key.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
